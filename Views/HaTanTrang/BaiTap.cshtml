
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ha Tan Trang_KtraFE</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
        }
        body {
            background-color: #eaeded;
        }
        .header {
            background-color: #131921;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 10px 20px;
            height: 60px;
        }
        .logo-text {
            font-size: 24px;
            font-weight: bold;
            color: #ff9900;
        }
        .nav-search {
            display: flex;
            flex: 1;
            max-width: 700px;
            margin: 0 20px;
        }
        .search-input {
            width: 100%;
            padding: 8px 10px;
            border: none;
            border-radius: 4px 0 0 4px;
            outline: none;
        }
        .search-btn {
            background-color: #febd69;
            border: none;
            padding: 0 15px;
            border-radius: 0 4px 4px 0;
            cursor: pointer;
            color: #111;
        }
        .nav-right {
            display: flex;
            gap: 20px;
        }
        .nav-link {
            color: white;
            text-decoration: none;
            font-size: 14px;
        }
        .nav-link:hover {
            text-decoration: underline;
        }
        .main-content {
            padding: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }
        .hero-banner {
            background: linear-gradient(to right, #d4e3fc, #ecd6f8);
            height: 300px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 50px;
            margin-bottom: -40px;
            border-radius: 8px;
            position: relative;
            z-index: 1;
        }
        .banner-text {
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        .banner-text h1 {
            font-size: 38px;
            color: #1a1a1a;
            font-weight: 700;
            line-height: 1.2;
            margin-bottom: 12px;
        }
        .banner-content h1 {
            font-size: 32px;
            color: #0f1111;
            font-weight: 700;
            line-height: 1.25;
            margin-bottom: 8px;
        }
        .alexa-brand {
            font-size: 26px;
            font-weight: bold;
            color: #111;
            font-family: Arial, sans-serif;
            letter-spacing: -0.5px;
        }
        .hero-banner h1 {
            font-size: 28px;
            color: #111;
            margin-bottom: 15px;
        }
        .product-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
            position: relative;
            z-index: 10;
        }
        .product-card {
            background-color: white;
            padding: 20px;
            border-radius: 4px;
            min-height: 380px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .product-card h2 {
            font-size: 18px;
            color: #0f1111;
            margin-bottom: 15px;
        }
        .card-grid-4 {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
        }
        .mini-item {
            display: flex;
            flex-direction: column;
        }
        .mini-item img {
            width: 100%;
            height: 100px;
            object-fit: cover;
            border-radius: 4px;
            margin-bottom: 5px;
        }
        .mini-item span {
            font-size: 12px;
            color: #0f1111;
        }
        .img-placeholder, .img-placeholder-large {
            background-color: #f0f0f0;
            width: 100%;
            height: 110px;
            margin-bottom: 5px;
            border-radius: 4px;
        }
        .card-single-img {
            width: 100%;
            height: 260px;
            overflow: hidden;
            margin-bottom: 10px;
        }
        .card-single-img .img-placeholder-large {
            height: 240px;
        }
        .card-single-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 4px;
            }
        .card-link {
            color: #007185;
            text-decoration: none;
            font-size: 13px;
            margin-top: 10px;
            display: inline-block;
        }
        .card-link:hover {
            text-decoration: underline;
            color: #c7511f;
        }
        @@media (max-width: 1024px) {
            .product-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
        .related-section {
            background-color: white;
            margin-top: 25px;
            padding: 20px;
            border-radius: 4px;
        }
        .related-section h3 {
            font-size: 20px;
            margin-bottom: 15px;
            color: #0f1111;
        }
        .see-more {
            color: #007185;
            font-size: 14px;
            font-weight: normal;
            cursor: pointer;
            margin-left: 10px;
        }
        .related-items-row {
            display: flex;
            gap: 20px;
            overflow-x: auto;
            padding-bottom: 10px;
        }
        .item-card img {
            height: 200px;
            width: 150px;
            object-fit: contain;
            background-color: #f7f7f7;
            border: 1px solid #ddd;
            border-radius: 4px;
        }
        .amazon-footer {
            background-color: #232f3e;
            color: white;
            margin-top: 40px;
        }
        .footer-top-btn {
            background-color: #37475a;
            text-align: center;
            padding: 15px 0;
        }
        .footer-top-btn a {
            color: white;
            text-decoration: none;
            font-size: 13px;
        }

        .footer-links-columns {
            display: flex;
            justify-content: space-around;
            padding: 40px 80px;
            max-width: 1200px;
            margin: 0 auto;
        }
        .footer-links-columns .col {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
         .footer-links-columns h4 {
            font-size: 16px;
            margin-bottom: 5px;
            color: #ffffff;
         }
         .footer-links-columns a {
            color: #dddddd;
            text-decoration: none;
            font-size: 13px;
         }
         footer-links-columns a:hover {
            text-decoration: underline;
         }
    </style>
</head>
<body>
    <header class="header">
        <div class="nav-left">
            <div class="nav-logo">
                <span class="logo-text">amazon</span>
            </div>
        </div>
        <div class="nav-search">
            <input type="text" class="search-input" placeholder="">
            <button class="search-btn"><i class="fas fa-search"></i></button>
        </div>
        <div class="nav-right">
            <a href="#" class="nav-link">Your Account</a>
            <a href="#" class="nav-link">Help</a>
            <a href="#" class="nav-link">Cart</a>
        </div>
    </header>
    <main class="main-content">
