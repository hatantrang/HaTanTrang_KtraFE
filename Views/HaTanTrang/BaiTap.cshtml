                    <a href="#" class="card-link">Try 30 days for free</a>
                </div>
            </div>
            <div class="product-card">
                <h2>Customers' most-loved</h2>
                <div class="card-grid-4">
                    <div class="mini-item">
                        <img src="https://media.routine.vn/1200x1500/prod/variant/10f25tslw009-beige-1-jpg-l7dj.webp" alt="Women's fashion">
