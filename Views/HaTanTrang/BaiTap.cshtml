                        <span>Baskets & hampers</span>
                    </div>
                    <div class="mini-item">
                        <img src="https://zsofa.vn/wp-content/uploads/2026/04/ban-an-9-17.jpeg" alt="Accent furniture">
                        <span>Accent furniture</span>
                    </div>
                    <div class="mini-item">
                        <img src="https://giaydantuongtranle.com/wp-content/uploads/2020/02/57d14bafb7cf52910bde.jpg" alt="Wallpaper & paint">
                        <span>Wallpaper & paint</span>
                    </div>
                    <div class="mini-item">
