                        <path d="M 85 0 L 95 5 L 88 12" stroke="#111" stroke-width="4" fill="transparent" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </div>
            <div class="banner-image">
                <img src="https://i.pinimg.com/474x/d4/9f/a3/d49fa3523c84bef766b4b2bde8296d23.jpg" alt="Amazon Devices" style="max-height: 220px; width: auto; object-fit: contain;">
            </div>
        </div>
        <div class="product-grid">
            <div class="product-card">
                <h2>Prime Video</h2>
